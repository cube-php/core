{
  "name": "cube-php/core",
  "description": "PHP Cube core utilities",
  "version": "0.2.1",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "dammynex",
      "email": "damilolaofficial@gmail.com"
